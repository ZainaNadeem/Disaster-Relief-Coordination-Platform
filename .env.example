# Copy this file to ".env" and fill in real values: cp .env.example .env
# docker-compose reads these automatically.

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=disaster_relief
# Host port to expose Postgres on (container always listens on 5432).
POSTGRES_PORT=5432

# ---- Server ----
SERVER_PORT=4000
# Connection string used by Prisma. In docker-compose the server overrides this
# to use host "postgres"; for local (non-Docker) dev use "localhost" as below.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/disaster_relief
# Secret used to sign/verify JWTs — use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- Client ----
NEXT_PUBLIC_API_URL=http://localhost:4000
# Mapbox token (client-side maps + geocoding). Leave blank to disable the map.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
