# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=disaster_relief
POSTGRES_PORT=5432

# Server
SERVER_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/disaster_relief
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Client
NEXT_PUBLIC_API_URL=http://localhost:4000
CLIENT_PORT=3000

# Mapbox — used CLIENT-SIDE only (maps + geocoding happen in the browser).
# NEXT_PUBLIC_ prefix is required for Next.js to expose it to browser code.
# The server never uses this token and does no geocoding.
NEXT_PUBLIC_MAPBOX_TOKEN=
